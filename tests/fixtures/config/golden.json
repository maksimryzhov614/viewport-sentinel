{
  "$schema": "../../../config.schema.json",
  "version": 1,
  "baseUrl": "http://127.0.0.1:4173",
  "pages": [
    { "name": "clean", "path": "/clean" },
    { "name": "overflow", "path": "/overflow" },
    { "name": "overlap", "path": "/overlap" },
    { "name": "picture", "path": "/picture" },
    { "name": "console", "path": "/console" }
  ],
  "viewports": [
    {
      "name": "mobile-320",
      "width": 320,
      "height": 844,
      "deviceScaleFactor": 1
    },
    {
      "name": "desktop-1440",
      "width": 1440,
      "height": 900,
      "deviceScaleFactor": 1
    }
  ],
  "timeoutMs": 10000,
  "output": {
    "dir": "artifacts/viewport-sentinel",
    "formats": ["json", "sarif"]
  }
}
