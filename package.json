{
  "name": "viewport-sentinel",
  "version": "0.0.0",
  "description": "Deterministic responsive and media regression checks in Chromium CI.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "bin": {
    "viewport-sentinel": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/model/types.d.ts",
      "import": "./dist/model/types.js"
    }
  },
  "files": [
    "dist",
    "config.schema.json",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/generate-schema.mjs",
    "schema:check": "npm run build && git diff --exit-code -- config.schema.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "fixture": "tsx fixtures/server.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "playwright": "1.62.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
